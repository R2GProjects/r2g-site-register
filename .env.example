NOCODB_URL=https://noco.edservices.synology.me
NOCODB_API_TOKEN=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Required in production — the app refuses to start without it.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Shared secret for the scheduled auto-close job. Generate the same way.
# Without it, POST /api/cron/auto-close can only be run by a signed-in admin.
CRON_SECRET=

# Optional auto-close tuning. Defaults shown.
# AUTO_CLOSE_CUTOFF — site-local time stamped on a forgotten day shift.
# AUTO_CLOSE_MAX_HOURS — a record open longer than this is treated as forgotten.
AUTO_CLOSE_CUTOFF=18:00
AUTO_CLOSE_MAX_HOURS=12

# How long a site induction stays valid before it must be run again.
INDUCTION_VALIDITY_DAYS=365
